NODE_ENV=development
PORT=4000

# Comma-separated origins allowed by CORS and the CSRF origin check (no trailing slash).
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used in email links). Defaults to the first CORS origin.
WEB_ORIGIN=http://localhost:5173

# Neon PostgreSQL. DATABASE_URL = pooled; DIRECT_DATABASE_URL = direct (used for migrations).
DATABASE_URL=
DIRECT_DATABASE_URL=

# Comma-separated approved registration domains (exact domain or any subdomain).
ALLOWED_EMAIL_DOMAINS=dtu.ac.in

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# 'lax' when web and API share a site (recommended: proxy /api through Vercel). 'none' only for cross-site (needs https).
COOKIE_SAMESITE=lax
# Proxies in front of the API: 1 on Render directly; 2 when Vercel rewrites /api to Render.
TRUST_PROXY=1

# One-time admin bootstrap (>= 32 chars). Call POST /api/setup/admin once, then delete both lines.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_TOKEN=

# Institutional SMTP. If unset in development, emails are printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Spectrum DTU <no-reply@example.edu>"
# Inbox that receives every contact-form message (sent through the SMTP settings above).
CONTACT_INBOX=dtu.spectrum@gmail.com

# Cloudinary (image uploads and private learning materials). Required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
